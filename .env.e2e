# Development on purpose, and it is the whole reason this suite can sign somebody in for real:
# with no mail provider the server refuses to start unless the environment says development out
# loud, and then it writes the letter to its own log. The browser reads the code from there,
# exactly as a person reads it from their inbox.
NODE_ENV=development
# Committed on purpose, like `.env.test`: it points at the disposable server in compose.yml and
# holds no secret. Its own database, because a browser walking a journey leaves rows behind and
# `pnpm test` should not have to step around them.
DATABASE_URL=postgres://handover:handover@localhost:5442/handover_e2e?sslmode=disable
AUTH_SECRET=e2e-secret-not-used-anywhere-that-matters
PORT=3199
PUBLIC_ORIGIN=http://localhost:3199
WEB_ORIGIN=http://localhost:3199
# Relative to the server's own directory, which is where it is started from.
WEB_ROOT=../web/dist
