NODE_ENV=test
# Committed on purpose: this points at the disposable test server in compose.yml and
# holds no secret. `pnpm test` works right after `pnpm db:up`, with no local setup.
DATABASE_URL=postgres://handover:handover@localhost:5442/handover_test?sslmode=disable
AUTH_SECRET=test-secret-not-used-anywhere-that-matters

OBJECT_STORE_BUCKET=handover
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_FORCE_PATH_STYLE=true
OBJECT_STORE_ACCESS_KEY=handover
OBJECT_STORE_SECRET_KEY=handover-local-object-secret
