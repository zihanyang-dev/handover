NODE_ENV=test
# Committed on purpose: this points at the disposable test server in compose.yml and
# holds no secret. `pnpm test` works right after `pnpm db:up`, with no local setup.
DATABASE_URL=postgres://handover:handover@localhost:5442/handover_test?sslmode=disable
AUTH_SECRET=test-secret-not-used-anywhere-that-matters

# A test process is not a server. The default of ten is sized for one process answering many
# people at once; here vitest runs one worker per core, and each worker opens a pool of its own.
# Measured against this suite on a ten-core machine: 35 backends at ten, 14 at four.
#
# Four rather than one, because some of these tests are *about* two things happening at once — two
# people saying something before either is answered, two instances of the server — and each of
# those needs a connection of its own while the other is mid-transaction.
DATABASE_POOL_MAX=4

# The bucket faces are kept in, pointed at the disposable MinIO in compose.yml.
OBJECT_STORE_BUCKET=handover
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_FORCE_PATH_STYLE=true
OBJECT_STORE_ACCESS_KEY=handover
OBJECT_STORE_SECRET_KEY=handover-local-object-secret
