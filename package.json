{
  "name": "handover",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/main.ts",
    "web": "vite --config web/vite.config.ts",
    "start": "node src/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down --volumes",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "test:db": "node --env-file=.env.test scripts/migrate.ts",
    "generate": "node --env-file=.env.test scripts/generate.ts",
    "typecheck": "tsc -p . --noEmit && tsc -p web --noEmit",
    "lint": "oxlint --type-aware .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm generate && git diff --exit-code generated && pnpm typecheck && pnpm lint && pnpm format && pnpm test"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "dbmate": "^2.35.0",
    "happy-dom": "^20.11.6",
    "kysely-codegen": "^0.20.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "hono": "^4.13.4",
    "kysely": "^0.29.5",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
