# Copy to .env. Real environment variables win over this file, so CI and production
# inject the same name directly and nothing in the code changes.

# The database this process talks to. compose.yml defines the dev server on 5432.
DATABASE_URL=postgres://handover:handover@localhost:5442/handover?sslmode=disable

# Any long random string. `openssl rand -hex 32` produces one.
AUTH_SECRET=replace-me-with-32-or-more-random-characters

# Connections this process holds. This times the number of instances must stay under the
# database server's max_connections, with room left over for migrations and for people.
DATABASE_POOL_MAX=10
