# Copy to .env. Real environment variables win over this file, so CI and production
# inject the same name directly and nothing in the code changes.

# What this process is: development, test or production. It has no default — a process that has
# not been told refuses to start, because every development convenience here is one that must not
# be on in production.
NODE_ENV=development

# The database this process talks to. compose.yml defines the dev server on 5432.
DATABASE_URL=postgres://handover:handover@localhost:5442/handover?sslmode=disable

# Any long random string. `openssl rand -hex 32` produces one.
AUTH_SECRET=replace-me-with-32-or-more-random-characters

# Immutable generated avatars live in an S3-compatible bucket. compose.yml provides this MinIO
# endpoint and creates the bucket for development. On AWS, leave ENDPOINT, ACCESS_KEY and
# SECRET_KEY empty so the SDK uses the instance or workload role; path-style should then be false.
OBJECT_STORE_BUCKET=handover
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_FORCE_PATH_STYLE=true
OBJECT_STORE_ACCESS_KEY=handover
OBJECT_STORE_SECRET_KEY=handover-local-object-secret

# Connections this process holds. This times the number of instances must stay under the
# database server's max_connections, with room left over for migrations and for people.
DATABASE_POOL_MAX=10

# Where the sign-in codes come from. Without a key the code goes to the log instead, which is
# enough to develop against and is refused outright in production.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# How many codes one caller may ask for in an hour. The wait between codes is per address, and
# somebody rotating addresses walks straight past it — every letter that goes that way costs money
# and spends this domain's reputation.
LETTERS_PER_CALLER_PER_HOUR=20

# Where the built browser app is, when this process serves it too. Unset, this is an API and
# nothing else — which is what a deployment with a proxy or a CDN in front of the pages wants.
# What is not allowed is a second origin: the page's calls carry no origin of their own and its
# session cookie is SameSite=Lax, so pages served elsewhere arrive signed out.
WEB_ROOT=

# How many proxies stand in front of this process. Zero means the connection is the caller and
# `X-Forwarded-For` is ignored: unset, that header is written by whoever is calling, and trusting
# it turns the limit above into a counter anybody can reset. One means the last entry in it was
# written by our own proxy, two means the one before that.
TRUSTED_PROXY_HOPS=0
