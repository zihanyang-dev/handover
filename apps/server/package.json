{
  "name": "@handover/server",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@handover/universal": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.1",
    "hono": "^4.13.4",
    "kysely": "^0.29.5",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dbmate": "^2.35.0",
    "kysely-codegen": "^0.20.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node --env-file=../../.env scripts/migrate.ts",
    "release": "node scripts/release.ts",
    "test:db": "node --env-file=../../.env.test scripts/migrate.ts && node --env-file=../../.env.test scripts/empty-test-database.ts",
    "generate": "node --env-file=../../.env.test scripts/generate.ts"
  }
}
