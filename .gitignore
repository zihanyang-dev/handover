node_modules

# pnpm's own content-addressed cache. Not a build product of this repository and not something
# anybody reads: a SQLite file with a write-ahead log, which every install and every test run
# rewrites. Committed, a read-only verification leaves a binary diff nobody can review.
.pnpm-store
*.log
.env
.DS_Store
coverage

# Derived from the filesystem, which is already in git, so committing it would only be a
# second copy of the routes. Unlike generated/, whose source is a database.
apps/web/routeTree.gen.ts
apps/web/dist
.tanstack

# The binaries a release is made of. Built from this source in one job, published to the release,
# and never worth keeping a copy of here.
apps/cli/dist
test-results/

# What the styling is measured against while it moves to tokens and utilities. Pictures of the
# product are not source, and a binary nobody can review is not a thing to keep in a history.
e2e/looks/*-darwin.png
e2e/looks/*-win32.png
apps/cli/dist-host/
